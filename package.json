{
  "name": "instantforge-generators-for-storytellers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify:build",
    "build:analytics-test": "vite build --mode analytics-test && npm run verify:build",
    "preview": "vite preview",
    "lint": "node scripts/check-source.mjs",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "test:unit": "node --test tests/utils.test.mjs tests/data-validation.test.mjs tests/forge-data.test.mjs tests/analytics.test.mjs",
    "test:browser": "npm run build:analytics-test && playwright test",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  }
}
